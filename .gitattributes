# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Explicitly text
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.sh       text eol=lf

# Binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.svg      text eol=lf
*.ico      binary
*.woff     binary
*.woff2    binary

# Generated — collapse in diffs and exclude from language stats
package-lock.json linguist-generated=true -diff
docs/SPEC.md      linguist-documentation=true
