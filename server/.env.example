# ---------------------------------------------------------------------------
# PulseKeeper — backend configuration
#
# Copy to server/.env and fill in. Never commit the real .env.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port the API listens on. 5000 is avoided on purpose: Windows reserves it in
# its Hyper-V excluded range and macOS uses it for the AirPlay receiver.
PORT=5050

# MongoDB connection string.
# Local Docker (npm run db:up):
MONGODB_URI=mongodb://localhost:27017/pulsekeeper
# MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pulsekeeper?retryWrites=true&w=majority

# Signing secret for authentication tokens. Required, minimum 32 characters,
# and must differ between environments. Rotating it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Token lifetime, e.g. 15m, 12h, 7d.
JWT_EXPIRES_IN=7d

# Allowed browser origins for CORS, comma-separated. Requests from anything
# else are refused. Use the exact origin, with no trailing slash.
CLIENT_URL=http://localhost:5173

# Shared secret for POST /api/monitor/run, used by external cron services.
# Optional in development; required when NODE_ENV=production. Minimum 16 chars.
MONITOR_CRON_SECRET=

# Run the in-process node-cron scheduler. Set to false when the backend is
# hosted somewhere that sleeps and an external cron service drives monitoring.
MONITOR_ENABLED=true

# Cron expression for the monitoring sweep. Every minute is correct: the sweep
# itself decides which sites are due, based on each site's own interval.
MONITOR_CRON=* * * * *

# Cron expression for the health-check retention cleanup.
CLEANUP_CRON=15 3 * * *

# How many sites are checked simultaneously in one sweep.
MONITOR_CONCURRENCY=5

# Redirect hops followed per check. Every hop is revalidated against the SSRF
# guard, so this is a cost control, not a security control.
MONITOR_MAX_REDIRECTS=3

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Set when running behind a reverse proxy (Render, Railway, nginx) so client
# IPs used for rate limiting come from X-Forwarded-For. Accepts a hop count
# or false.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Email notification channels (optional)
#
# Email channels are only offered when SMTP_HOST and SMTP_FROM are both set.
# Leave these blank to run without a mail relay; Slack, Discord, and generic
# webhook channels need no configuration at all.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PulseKeeper <alerts@example.com>
SMTP_SECURE=false

# Public URL of the dashboard, used for links inside outbound notifications.
# Falls back to the first entry in CLIENT_URL.
DASHBOARD_URL=
